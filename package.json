{
  "name": "wifi-lan-file-drop",
  "productName": "WiFi LAN File Drop",
  "description": "লোকাল ওয়াইফাই ও ল্যান নেটওয়ার্কে একাধিক পিসি ও ল্যাপটপের মাঝে উচ্চগতির ফাইল ট্রান্সফার সফটওয়্যার",
  "private": true,
  "version": "1.0.0",
  "author": "WiFi LAN File Drop Team",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node server.ts",
    "bundle:server": "esbuild electron/embedded-server.cjs --bundle --platform=node --target=node20 --outfile=electron/embedded-server.bundle.cjs",
    "build": "npm run bundle:server && vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js release electron/embedded-server.bundle.cjs",
    "lint": "tsc --noEmit",
    "electron:dev": "cross-env NODE_ENV=development electron .",
    "electron:build": "npm run build && electron-builder --win",
    "build:exe": "npm run build && electron-builder --win nsis",
    "build:portable": "npm run build && electron-builder --win portable",
    "pack": "electron-builder --dir"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tsx": "^4.21.0",
    "vite": "^8.3.0",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "autoprefixer": "^10.4.21",
    "cross-env": "^10.1.0",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "build": {
    "appId": "com.wifilan.filedrop",
    "productName": "WiFi LAN File Drop",
    "copyright": "Copyright © 2026",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "public/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "WiFi LAN File Drop",
      "uninstallDisplayName": "WiFi LAN File Drop"
    }
  }
}
